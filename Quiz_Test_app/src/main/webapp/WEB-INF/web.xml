<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="https://jakarta.ee/xml/ns/jakartaee"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
	id="WebApp_ID" version="6.0">
	<display-name>Quiz Test Application</display-name>
	<description>Multi-page quiz application with user authentication</description>

	<!-- Welcome file list -->
	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
		<welcome-file>login.html</welcome-file>
	</welcome-file-list>

	<!-- Session configuration -->
	<session-config>
		<session-timeout>5</session-timeout> <!-- 5 minutes timeout -->
		<cookie-config>
			<http-only>true</http-only>
			<secure>false</secure> <!-- Set to true in production with HTTPS -->
		</cookie-config>
	</session-config>

	<!-- Error pages -->
	<error-page>
		<error-code>404</error-code>
		<location>/error.html</location>
	</error-page>

	<error-page>
		<error-code>500</error-code>
		<location>/error.html</location>
	</error-page>

	<!-- Context parameters -->
	<context-param>
		<param-name>quiz.questions.count</param-name>
		<param-value>4</param-value>
	</context-param>

	<context-param>
		<param-name>quiz.time.limit</param-name>
		<param-value>60</param-value> <!-- 60 seconds -->
	</context-param>

	<!-- Listener for database initialization -->
	<listener>
		<listener-class>com.quiz.DatabaseInitializationListener</listener-class>
	</listener>
</web-app>